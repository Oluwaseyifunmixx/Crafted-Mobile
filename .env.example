# Copy this file to .env.local and fill in the two values.
# Both are public by design (safe inside a mobile app): Row Level Security in the
# database is what protects each shopper's data. Never put the Supabase secret
# key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>